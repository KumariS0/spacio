# ─── Supabase ──────────────────────────────────────────────────────────────
# Project Settings → API. The anon key is safe in the browser (RLS protects data).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SERVER ONLY. Never prefix with NEXT_PUBLIC_. Used for OTP rate limiting,
# account deletion, the make-admin script and the E2E/race-test scripts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SERVER ONLY, used by `npm run db:push` (Connect → Session pooler). Not needed
# by the website itself, so you don't have to add it to your host.
SUPABASE_DB_URL=postgresql://postgres.YOUR-PROJECT-REF:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres

# ─── Authentication ────────────────────────────────────────────────────────
# Comma-separated list of email domains allowed to sign in. Keep this in sync
# with the public.allowed_email_domains table (the database enforces it too).
ALLOWED_EMAIL_DOMAINS=srmist.edu.in
# Length of the email OTP configured in Supabase (Auth → Providers → Email).
NEXT_PUBLIC_OTP_LENGTH=6

# ─── Site & campus ─────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CAMPUS_NAME=SRM Institute of Science and Technology, Kattankulathur
NEXT_PUBLIC_CAMPUS_SHORT_NAME=SRM KTR
NEXT_PUBLIC_CAMPUS_TZ=Asia/Kolkata

# ─── Street map (optional) ─────────────────────────────────────────────────
# Leave blank until you have verified coordinates. Without them the campus map
# uses the schematic view only and never shows guessed geographic pins.
NEXT_PUBLIC_MAP_CENTER_LAT=
NEXT_PUBLIC_MAP_CENTER_LNG=
NEXT_PUBLIC_MAP_ZOOM=17

# ─── Scheduled jobs ────────────────────────────────────────────────────────
# Shared secret for GET /api/cron/sweep (expires no-shows / overstays).
CRON_SECRET=generate-a-long-random-string

# ── Nook, the AI assistant (optional) ─────────────────────────────────────────────────
# Server-only. Get a key at https://openrouter.ai/keys. Never prefix with NEXT_PUBLIC_.
# Without it, the chat button is hidden in production. With it, Nook appears on
# the landing page for visitors (guest mode) and on every student page.
OPENROUTER_API_KEY=
# Any OpenRouter model id. Default "openrouter/auto" lets OpenRouter pick.
# To use Google Gemini, set a Gemini model id from https://openrouter.ai/models?q=gemini
OPENROUTER_MODEL=openrouter/auto
# Messages per student per window (seconds). Defaults: 20 per 600 s.
ASSISTANT_RATE_LIMIT=20
ASSISTANT_RATE_WINDOW_SECONDS=600
# Guest mode: visitors who aren't signed in get general help only (no spaces,
# availability or bookings). "off" requires sign-in. Guests get a per-IP limit
# per window above, plus an hourly cap for the whole server instance.
ASSISTANT_GUEST_MODE=on
ASSISTANT_GUEST_RATE_LIMIT=8
ASSISTANT_GUEST_GLOBAL_LIMIT=150
